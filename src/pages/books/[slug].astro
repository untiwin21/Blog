---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getBookCover, type Book } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props as { book: Book };
const { title, author, category, readDate, rating, oneLine } = book.data;
const cover = getBookCover(book);
const { Content } = await render(book);
const stars = rating != null ? '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating)) : null;
---

<BaseLayout title={title} description={oneLine ?? `${title} 독서 노트`}>
  <div class="container narrow">
    <a class="crumb" href={url('/books/')}>← Books</a>
    <header class="book-header">
      <div class="cover-wrap">
        {
          cover ? (
            <Image src={cover} alt={`${title} 표지`} width={440} class="cover" />
          ) : (
            <div class="cover placeholder">{title}</div>
          )
        }
      </div>
      <div class="info">
        <span class="tag">{category}</span>
        <h1>{title}</h1>
        <p class="author">{author}</p>
        <dl>
          {
            readDate && (
              <>
                <dt>읽은 날짜</dt>
                <dd>{formatDate(readDate)}</dd>
              </>
            )
          }
          {
            stars && (
              <>
                <dt>평점</dt>
                <dd class="stars" aria-label={`5점 만점에 ${rating}점`}>
                  {stars}
                </dd>
              </>
            )
          }
        </dl>
        {oneLine && <blockquote class="one-line">{oneLine}</blockquote>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  .crumb {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .book-header {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    align-items: start;
    margin: 1.4rem 0 2.4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .cover {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .placeholder {
    aspect-ratio: 1 / 1.45;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    font-weight: 600;
    color: var(--text-soft);
    background: linear-gradient(160deg, var(--bg-soft), var(--border));
  }
  h1 {
    margin: 0.6rem 0 0.2rem;
    font-size: 1.8rem;
    line-height: 1.3;
  }
  .author {
    margin: 0 0 1rem;
    color: var(--text-soft);
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  dt {
    color: var(--text-muted);
  }
  dd {
    margin: 0;
  }
  .stars {
    color: #f5a524;
    letter-spacing: 0.1em;
  }
  .one-line {
    margin: 0;
    padding: 0.6rem 1rem;
    border-left: 4px solid var(--accent);
    background: var(--bg-soft);
    border-radius: 0 6px 6px 0;
    color: var(--text-soft);
  }
  @media (max-width: 600px) {
    .book-header {
      grid-template-columns: 1fr;
    }
    .cover-wrap {
      max-width: 200px;
    }
  }
</style>
