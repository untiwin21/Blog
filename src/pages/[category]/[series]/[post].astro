---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Toc from '../../../components/Toc.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import {
  getPosts,
  getSeriesMap,
  postsInSeries,
  postSlug,
  postUrl,
  seriesSlug,
  seriesUrl,
  formatDate,
  type Post,
  type Series,
} from '../../../lib/content';

export async function getStaticPaths() {
  const [posts, seriesMap] = await Promise.all([getPosts(), getSeriesMap()]);
  return posts.map((post) => {
    const series = seriesMap.get(post.data.series.id);
    if (!series) throw new Error(`글 "${post.id}"의 series "${post.data.series.id}"가 없습니다.`);
    const siblings = postsInSeries(posts, series);
    const i = siblings.findIndex((p) => p.id === post.id);
    return {
      params: { category: series.data.category, series: seriesSlug(series), post: postSlug(post) },
      props: { post, series, prev: siblings[i - 1], next: siblings[i + 1], seriesMap },
    };
  });
}

const { post, series, prev, next, seriesMap } = Astro.props as {
  post: Post;
  series: Series;
  prev?: Post;
  next?: Post;
  seriesMap: Map<string, Series>;
};
const { Content, headings } = await render(post);
const { title, date, tags, youtube } = post.data;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title}>
  <div class="post-layout">
    <article class="article">
      <header class="post-header">
        <a class="series-link" href={seriesUrl(series)}>{series.data.title}</a>
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {tags?.map((t) => <span class="tag">{t}</span>)}
        </div>
      </header>

      {
        tocHeadings.length > 0 && (
          <details class="toc-mobile">
            <summary>목차</summary>
            <Toc headings={headings} />
          </details>
        )
      }

      {youtube && <YouTubeEmbed url={youtube} title={`${title} 강의 영상`} />}

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="시리즈 내 이전/다음 글">
        {
          prev ? (
            <a class="pager-link prev" href={postUrl(prev, seriesMap)}>
              <span class="label">← 이전 글</span>
              <span class="t">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="pager-link next" href={postUrl(next, seriesMap)}>
              <span class="label">다음 글 →</span>
              <span class="t">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
      <p class="back"><a href={seriesUrl(series)}>‹ {series.data.title} 목록으로</a></p>
    </article>

    <aside class="toc-desktop">
      <div class="sticky"><Toc headings={headings} /></div>
    </aside>
  </div>
</BaseLayout>

<script>
  // 스크롤 위치에 맞춰 목차 항목 강조
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]'));
  const targets = Array.from(new Set(links.map((a) => a.dataset.slug!)))
    .map((s) => document.getElementById(s))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const setActive = (slug: string) =>
      links.forEach((a) => a.classList.toggle('active', a.dataset.slug === slug));
    const onScroll = () => {
      const y = window.scrollY + 120;
      let current = targets[0].id;
      for (const t of targets) if (t.offsetTop <= y) current = t.id;
      setActive(current);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--content-w)) 220px;
    justify-content: center;
    gap: 56px;
    padding: 0 20px;
  }
  .article {
    min-width: 0;
  }
  .post-header {
    padding: 2.6rem 0 1.6rem;
    margin-bottom: 1.8rem;
    border-bottom: 1px solid var(--border);
  }
  .series-link {
    font-size: 0.9rem;
    font-weight: 600;
  }
  h1 {
    font-size: 2rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.8rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .toc-desktop .sticky {
    position: sticky;
    top: calc(var(--nav-h) + 2.6rem);
    max-height: calc(100vh - var(--nav-h) - 4rem);
    overflow-y: auto;
    padding-top: 2.6rem;
  }
  .toc-mobile {
    display: none;
    margin: 0 0 1.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-soft);
  }
  .toc-mobile summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .toc-mobile :global(.toc-title) {
    display: none;
  }
  .toc-mobile :global(.toc) {
    margin-top: 0.6rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
  }
  .pager-link:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .pager-link.next {
    text-align: right;
  }
  .pager-link .label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .pager-link .t {
    font-weight: 600;
  }
  .back {
    margin-top: 1.4rem;
    font-size: 0.9rem;
  }
  @media (max-width: 1080px) {
    .post-layout {
      grid-template-columns: minmax(0, var(--content-w));
    }
    .toc-desktop {
      display: none;
    }
    .toc-mobile {
      display: block;
    }
  }
  @media (max-width: 600px) {
    h1 {
      font-size: 1.6rem;
    }
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
