---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE, CATEGORIES } from '../config/site';
import { getPosts, getSeriesMap, postUrl, seriesUrl, byDateDesc } from '../lib/content';
import { url } from '../lib/url';

const [posts, seriesMap] = await Promise.all([getPosts(), getSeriesMap()]);
const recent = posts
  .sort(byDateDesc)
  .slice(0, SITE.recentPostCount)
  .map((p) => {
    const s = seriesMap.get(p.data.series.id)!;
    return {
      title: p.data.title,
      href: postUrl(p, seriesMap),
      date: p.data.date,
      tags: p.data.tags,
      youtube: !!p.data.youtube,
      seriesTitle: s.data.title,
      seriesHref: seriesUrl(s),
    };
  });
---

<BaseLayout>
  <div class="container narrow">
    <section class="intro">
      <h1>{SITE.author}</h1>
      <p class="affil">{SITE.affiliation}</p>
      <p class="bio">{SITE.intro}</p>
      <div class="cats">
        {CATEGORIES.map((c) => <a href={url(`/${c.key}/`)}>{c.label}</a>)}
        <a href={url('/books/')}>Books</a>
      </div>
    </section>

    <h2 class="section-title">최근 글</h2>
    {recent.length ? <PostList items={recent} /> : <p class="muted">아직 글이 없습니다.</p>}
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  .intro {
    padding: 3.5rem 0 1rem;
  }
  h1 {
    font-size: 2.1rem;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .affil {
    margin: 0.2rem 0 1rem;
    color: var(--text-soft);
    font-weight: 500;
  }
  .bio {
    margin: 0 0 1.4rem;
    color: var(--text-soft);
    max-width: 640px;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cats a {
    padding: 4px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.9rem;
  }
  .cats a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
</style>
