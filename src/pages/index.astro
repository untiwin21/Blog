---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config/site';
import { getPosts, getSeriesMap, postUrl, seriesUrl, byDateDesc } from '../lib/content';

const [posts, seriesMap] = await Promise.all([getPosts(), getSeriesMap()]);
const recent = posts
  .sort(byDateDesc)
  .slice(0, SITE.recentPostCount)
  .map((p) => {
    const s = seriesMap.get(p.data.series.id)!;
    return {
      title: p.data.title,
      href: postUrl(p, seriesMap),
      date: p.data.date,
      tags: p.data.tags,
      youtube: !!p.data.youtube,
      seriesTitle: s.data.title,
      seriesHref: seriesUrl(s),
    };
  });
---

<BaseLayout>
  <div class="container narrow">
    <h1 class="home-title">{SITE.title}</h1>

    {
      recent.length > 0 && (
        <>
          <h2 class="section-title">최근 글</h2>
          <PostList items={recent} />
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  .home-title {
    font-size: 2.2rem;
    letter-spacing: -0.02em;
    margin: 0;
    padding: 3.5rem 0 1rem;
  }
</style>
