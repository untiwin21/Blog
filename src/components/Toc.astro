---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  headings.length > 0 && (
    <nav class="toc" aria-label="목차">
      <p class="toc-title">목차</p>
      <ul>
        {headings.map((h) => (
          <li class={`d${h.depth}`}>
            <a href={`#${h.slug}`} data-slug={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .toc-title {
    font-weight: 700;
    margin: 0 0 0.6rem;
    color: var(--text);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.8rem;
    border-left: 1px solid var(--border);
  }
  li {
    margin: 0.35rem 0;
  }
  li.d3 {
    padding-left: 0.85rem;
  }
  a {
    color: var(--text-muted);
  }
  a:hover {
    color: var(--text);
    text-decoration: none;
  }
  a.active {
    color: var(--accent);
    font-weight: 600;
  }
</style>
